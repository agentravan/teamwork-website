# TeamWork Group - Environment Variables Example
# Copy this file to .env or .env.local and fill in the values before deployment.

# -----------------------------------------------------------------------------
# LEAD ROUTING & API CONFIGURATION
# -----------------------------------------------------------------------------
# Webhook URL (e.g. Google Sheets Apps Script, Zapier, Make, or CRM webhook)
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Resend API Key for automated email notification (Option A)
RESEND_API_KEY=re_123456789_YourResendApiKeyHere
NOTIFICATION_EMAIL=contact@teamworkgroup.in

# SMTP Configuration for email notification (Option B - fallback if Resend not used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@teamworkgroup.in
SMTP_PASS=your_app_password_here

# -----------------------------------------------------------------------------
# ANALYTICS & AD TRACKING PIXELS
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (e.g., 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Google Ads Conversion ID (e.g., AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-123456789

# -----------------------------------------------------------------------------
# BUSINESS CONTACT & WHATSAPP
# -----------------------------------------------------------------------------
# WhatsApp Business Number (e.g., 919876543210 without + or spaces)
# REQUIRED PRE-LAUNCH INPUT — replace with actual registered WhatsApp business number
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
